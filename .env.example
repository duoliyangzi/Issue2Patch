# Issue2Patch env example
# Copy to .env or set in shell / mini-extra config

# Tongyi / DashScope (recommended for CN resume stack consistency with campus-xianyu)
DASHSCOPE_API_KEY=sk-your-key
ISSUE2PATCH_MODEL=dashscope/qwen-plus

# Or OpenAI-compatible
# OPENAI_API_KEY=sk-...
# OPENAI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
# ISSUE2PATCH_MODEL=openai/qwen-plus

# Optional: silence mini-swe-agent startup banner
MSWEA_SILENT_STARTUP=1
